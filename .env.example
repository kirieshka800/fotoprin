# PostgreSQL. Create this database before cargo run; migrations apply automatically.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/fotoprint
# Both a base URL and a full /api/generate URL are supported.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=32768
DEFAULT_USER_ROLE=manager

# Audio transcription: set these for your running Docker/service (see AUDIO_SETUP.md).
# WHISPER_URL=http://127.0.0.1:8000
# WHISPER_PROVIDER=openai
# WHISPER_MODEL=Systran/faster-whisper-small
# WHISPER_LANGUAGE=ru
# WHISPER_TIMEOUT_SECONDS=600
# WHISPER_API_KEY=
